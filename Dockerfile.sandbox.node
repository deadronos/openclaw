FROM node:current-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ARG UID_BUILD=1000
ARG GID_BUILD=1000

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    ripgrep \
    tini \
    sudo \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    chromium \
    curl \
    fonts-liberation \
    fonts-noto-color-emoji \
    git \
    jq \
    novnc \
    python3 \
    socat \
    websockify \
    x11vnc \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

RUN usermod -d /home/openclaw -l openclaw node
RUN groupmod -n openclaw node
RUN mv /home/node /home/openclaw
RUN chown -R openclaw:openclaw /home/openclaw
RUN mkdir -p /home/openclaw/workspace
RUN chown -R openclaw:openclaw /home/openclaw/workspace
RUN mkdir -p /etc/sudoers.d
RUN echo "openclaw ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/openclaw
RUN groupmod -a -U openclaw sudo
RUN groupmod -g "${GID_BUILD}" openclaw
RUN usermod -u "${UID_BUILD}" openclaw
RUN usermod -s /bin/bash openclaw

COPY scripts/sandbox-browser-entrypoint.sh /usr/local/bin/openclaw-sandbox-browser
RUN chmod +x /usr/local/bin/openclaw-sandbox-browser
EXPOSE 9222 5900 6080

USER openclaw
WORKDIR /home/openclaw

CMD ["/usr/local/bin/openclaw-sandbox-browser"]
